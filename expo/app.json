{
  "expo": {
    "name": "替身计时器",
    "slug": "naruto-substitute-timer",
    "version": "0.3.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.narutotimer.mobile",
      "buildNumber": "4"
    },
    "android": {
      "package": "com.narutotimer.mobile"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#10131a"
        }
      ],
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ],
      "./plugins/withReplayKit"
    ]
  }
}
