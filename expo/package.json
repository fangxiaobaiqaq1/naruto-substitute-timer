{
  "name": "naruto-substitute-timer-mobile",
  "version": "0.3.0",
  "private": true,
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "node --test ios-compat/*check.cjs && node modules/naruto-capture/checks/check.cjs",
    "build:ios:simulator": "eas build --platform ios --profile simulator",
    "build:ios:device": "eas build --platform ios --profile preview"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.16",
    "expo-build-properties": "~58.0.11",
    "expo-splash-screen": "~58.0.10",
    "expo-status-bar": "~58.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@types/react": "~19.3.0",
    "typescript": "~6.0.3"
  }
}
